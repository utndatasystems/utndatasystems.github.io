// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/jekyll
{
  "name": "Jekyll",
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Install the versions locked by the project, including Prettier and its Liquid plugin.
  "postCreateCommand": "bundle install && npm ci",
  "postStartCommand": "bash \"${containerWorkspaceFolder}/.devcontainer/start-jekyll.sh\"",
  "postAttachCommand": "bash \"${containerWorkspaceFolder}/.devcontainer/start-jekyll.sh\"",
  "waitFor": "postStartCommand",
  "forwardPorts": [8080, 35729],
  "portsAttributes": {
    "8080": {
      "label": "Jekyll website",
      "onAutoForward": "openBrowser"
    },
    "35729": {
      "label": "Jekyll LiveReload",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "sissel.shopify-liquid", "yzhang.markdown-all-in-one"],
      "settings": {
        // use prettier code formatter as default formatter
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "prettier.configPath": ".prettierrc",
        "editor.formatOnSave": true
      }
    }
  },

  "remoteUser": "vscode"
}
