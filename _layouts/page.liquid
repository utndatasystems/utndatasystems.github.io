---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    {% assign related_publications_title = page.related_publications_title | default: "References" %}
    {% if page.related_publications_heading_level == 4 %}
      <h4 id="{{ related_publications_title | slugify }}" class="related-publications-title">{{ related_publications_title }}</h4>
    {% else %}
      <h2 id="{{ related_publications_title | slugify }}" class="related-publications-title">{{ related_publications_title }}</h2>
    {% endif %}
    <div class="publications related-publications">
      {% if page.related_publications_group_by == "none" %}
        {% bibliography --group_by none --cited_in_order %}
      {% else %}
        {% bibliography --cited_in_order %}
      {% endif %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
